<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <!-- Botón - -->
    <ImageButton
        android:id="@+id/btn_notif_boost_minus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_notif_button"
        android:contentDescription="Disminuir"
        android:padding="6dp"
        android:src="@drawable/ic_notif_minus" />

    <!-- Línea horizontal de nivel (ProgressBar) -->
    <ProgressBar
        android:id="@+id/notif_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:max="20"
        android:progress="0"
        android:progressTint="#00E5FF"
        android:progressBackgroundTint="#2A3447" />

    <!-- Porcentaje de Boost -->
    <TextView
        android:id="@+id/tv_notif_boost_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="+0%"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Botón + -->
    <ImageButton
        android:id="@+id/btn_notif_boost_plus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_notif_button"
        android:contentDescription="Aumentar"
        android:padding="6dp"
        android:src="@drawable/ic_notif_plus" />

</LinearLayout>
